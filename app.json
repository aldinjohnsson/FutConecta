{
  "expo": {
    "name": "Futebol Amador",
    "slug": "futebol-amador",
    "scheme": "futebolamador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o app acesse suas fotos para escolher a foto de perfil."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.futebolamador.app"
    },
    "android": {
      "package": "br.com.futebolamador.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
