# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Use APENAS a chave anon/publishable aqui;
# a service_role nunca vai para o app.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# Endereço público do app na web (usado no link de convite do WhatsApp). Sem barra no final.
# Em desenvolvimento pode ficar vazio na web (usa o endereço atual, ex.: http://localhost:8081).
EXPO_PUBLIC_APP_URL=
